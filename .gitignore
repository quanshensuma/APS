# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# 输出产物
out/
*.log
*.tmp
*.bak

# 客户数据（红线！台账是客户商业数据，绝对不能进仓库）
*.xlsx
*.xlsm
*.xls
*.csv
data/*
!data/.gitkeep
!docs/samples/*.md

# 例外：tests/samples/ 下的是【合成测试数据】（由 _verify/gen_samples.py 生成），
# 不是客户台账、不含任何真实客户信息，为「换数据回归测试」必须入库。
# 真实客户台账仍被上面的 *.xlsx 规则排除，不要往这里放客户文件。
!tests/samples/*.xlsx

# 中间产物（排程结果转储，含客户单号，可由 run.py / app.py 重生成）
gen*.json
g.json
g2.json
*.tmp.json
!package.json
!*.config.json

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 开发工具依赖（playwright 19MB，不进仓库，需要时 npx playwright install）
.devtools/
node_modules/

# 临时
~$*
_tmp_*
